# Copy to .env and fill in
DATABRICKS_HOST=https://adb-1234567890123456.7.azuredatabricks.net
DATABRICKS_TOKEN=dapiXXXXXXXXXXXXXXXX
# Workspace folder where you imported the 3 notebooks from ./notebooks
NOTEBOOK_DIR=/Workspace/Users/you@company.com/airflow_medallion
# Optional: existing cluster id. Leave empty to use serverless.
CLUSTER_ID=
# Where the bronze/silver/gold tables are written (schema is created at runtime by the create_schema task)
CATALOG=dev
SCHEMA=airflow_medallion
# Airflow UI login (fixed, kept across restarts)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
